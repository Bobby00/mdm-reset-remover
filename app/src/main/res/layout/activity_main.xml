<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_app_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status Section -->
        <TextView
            android:id="@+id/tv_status_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_header"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            app:layout_constraintTop_toBottomOf="@id/tv_app_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_margin="24dp" />

        <TextView
            android:id="@+id/tv_adb_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_adb_checking"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_status_header"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_device_owner_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_device_owner_checking"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_adb_status"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_play_services_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_play_services_checking"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_device_owner_status"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_play_store_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_play_store_checking"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_play_services_status"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_aurora_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_aurora_checking"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_play_store_status"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Button Section -->
        <TextView
            android:id="@+id/tv_actions_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/actions_header"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            app:layout_constraintTop_toBottomOf="@id/tv_aurora_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_margin="24dp" />

        <Button
            android:id="@+id/btn_check_adb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_check_adb"
            app:layout_constraintTop_toBottomOf="@id/tv_actions_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_check_device_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_check_device_owner"
            app:layout_constraintTop_toBottomOf="@id/btn_check_adb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_clear_play_services"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_clear_play_services"
            app:layout_constraintTop_toBottomOf="@id/btn_check_device_owner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_disable_play_store"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_disable_play_store"
            app:layout_constraintTop_toBottomOf="@id/btn_clear_play_services"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_install_aurora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_install_aurora"
            app:layout_constraintTop_toBottomOf="@id/btn_disable_play_store"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_do_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_do_all"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_install_aurora"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="20dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>